rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    // Il ruolo vive in Firestore (users/{uid}.role), non nei custom claims (piano
    // Spark, coerente con firestore.rules). Storage Rules può leggere Firestore con
    // firestore.get, esattamente come Firestore Rules usa get() su altri documenti.
    function myRole() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdminOrAbove() {
      return isSignedIn() && (myRole() == 'superadmin' || myRole() == 'admin');
    }

    function isValidImage() {
      return request.resource.contentType in
        ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
    }

    function isUnderSizeLimit() {
      return request.resource.size < 5 * 1024 * 1024; // 5 MB
    }

    // Fase 7 — foto di gruppo della squadra: teams/{teamId}/team-photo/{filename}.
    // Lettura pubblica (mostrata a chiunque nel popup squadra), scrittura riservata ad
    // admin/superAdmin. Il resultManager non è autorizzato in nessun caso.
    match /teams/{teamId}/team-photo/{fileName} {
      allow read: if true;
      allow write: if isAdminOrAbove() && isValidImage() && isUnderSizeLimit();
      allow delete: if isAdminOrAbove();
    }

    // Nessun altro percorso è ammesso: neghiamo esplicitamente tutto il resto,
    // così un nuovo percorso introdotto per errore non è scrivibile di default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
