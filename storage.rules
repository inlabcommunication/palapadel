rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return myUser().role;
    }

    function isEnabledUser() {
      return isSignedIn() && myUser().disabled != true;
    }

    function isAdminOrAbove() {
      return isEnabledUser() && (myRole() == 'superadmin' || myRole() == 'admin');
    }

    function isValidImage() {
      return request.resource.contentType in
        ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
    }

    function isUnderSizeLimit() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    function publishedHomeNews(newsId) {
      return firestore.get(/databases/(default)/documents/homeNews/$(newsId)).data.status == 'pubblicato';
    }

    match /teams/{teamId}/team-photo/{fileName} {
      allow read: if true;
      allow create, update: if isAdminOrAbove() && isValidImage() && isUnderSizeLimit();
      allow delete: if isAdminOrAbove();
    }

    match /home-news/{newsId}/cover/{fileName} {
      allow read: if publishedHomeNews(newsId) || isAdminOrAbove();
      allow create, update: if isAdminOrAbove() && isValidImage() && isUnderSizeLimit();
      allow delete: if isAdminOrAbove();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
