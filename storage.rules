rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function myUser() {
      return firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
    }

    function myRole() {
      return myUser().role;
    }

    function isEnabledUser() {
      return isSignedIn() && myUser().disabled != true;
    }

    function isSuperAdmin() {
      return isEnabledUser() && myRole() in ['superAdmin', 'superadmin'];
    }

    function isValidImage() {
      return request.resource.contentType in
        ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
    }

    function isUnderSizeLimit() {
      return request.resource.size <= 5 * 1024 * 1024;
    }

    function publishedHomeNews(newsId) {
      let news = firestore.get(/databases/(default)/documents/homeNews/$(newsId)).data;
      return news.status == 'pubblicato' &&
        news.active != false &&
        news.deleted != true;
    }

    match /teams/{teamId}/team-photo/{fileName} {
      allow read: if true;
      allow create, update: if isSuperAdmin() && isValidImage() && isUnderSizeLimit();
      allow delete: if isSuperAdmin();
    }

    // Loghi delle tipologie di campionato (Serie B/C, Principianti, Femminile, ecc.):
    // lettura pubblica (servono per mostrarli nell'interfaccia), caricamento/sostituzione/
    // eliminazione riservati al Super Admin. Admin e Gestore risultati non possono toccarli.
    match /branding/championships/{championshipTypeId}/logo/{fileName} {
      allow read: if true;
      allow create, update: if isSuperAdmin() && isValidImage() && isUnderSizeLimit();
      allow delete: if isSuperAdmin();
    }

    // Logo InLab mostrato in fondo a ogni pagina (footer "Web app creata da InLab"):
    // stessa politica, lettura pubblica e scrittura solo Super Admin.
    match /branding/inlab/logo/{fileName} {
      allow read: if true;
      allow create, update: if isSuperAdmin() && isValidImage() && isUnderSizeLimit();
      allow delete: if isSuperAdmin();
    }

    match /home-news/{newsId}/cover/{fileName} {
      allow read: if publishedHomeNews(newsId) || isSuperAdmin();
      allow create, update: if isSuperAdmin() && isValidImage() && isUnderSizeLimit();
      allow delete: if isSuperAdmin();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
